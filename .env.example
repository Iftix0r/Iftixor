TELEGRAM_BOT_TOKEN=your_bot_token_here
MODEL_CHECKPOINT_PATH=checkpoints/iftixor.pt

# Ixtiyoriy: o'qitish jarayoni progressini shu chat_id'ga Telegram orqali yuboradi.
# Chat ID olish: botga istalgan xabar yuboring, keyin brauzerda oching:
# https://api.telegram.org/bot<TOKEN>/getUpdates va "chat":{"id": ...} qiymatini oling.
ADMIN_CHAT_ID=

# Ixtiyoriy: sun'iy (synthetic) o'quv ma'lumoti generatsiya qilish uchun
# (iftixor/gen_synthetic_data.py). Hech qachon bu qiymatni chatga yoki
# GitHub'ga yubormang — faqat shu faylning nusxasi bo'lgan .env'ga yozing.
OPENAI_API_KEY=
